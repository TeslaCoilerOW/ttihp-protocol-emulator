+(* Area-study knobs (scratch copy only; not part of the design of record). *)
+open Hardcaml
+let env name default = match Sys.getenv_opt name with Some v when v <> "" -> v | _ -> default
+let int name default = int_of_string (env name (string_of_int default))
+let flag name = env name "0" = "1"
+let prefix = ref ""
+let completed_width () = int "AREA_COMPLETED_WIDTH" 32
+let dp_noclear () = flag "AREA_DP_NOCLEAR"
+let async_reset () = flag "AREA_ASYNC_RESET"
+(* AREA_RST_SYNC: number of reset-release synchronizer flops in async mode
+   (0 = the async reset net is ~(rst_n & ena) directly). *)
+let rst_sync () = int "AREA_RST_SYNC" 0
+let narrow_image () = flag "AREA_NARROW_IMAGE"
+let narrow_pc () = flag "AREA_NARROW_PC"
+let no_ena () = flag "AREA_NO_ENA"
+(* In async mode the processor stores its chip-wide asynchronous reset net here
+   so FIFOs can combine it with their synchronous FLUSH clear. *)
+let global_reset : Signal.t option ref = ref None
+let spec ~clock ~clear ~dp =
+  if dp && dp_noclear () then Reg_spec.create ~clock ()
+  else if async_reset () then Reg_spec.create ~clock ~reset:clear ()
+  else Reg_spec.create ~clock ~clear ()
+(* FIFO pointers.  Sync mode: [clear] = chip clear OR flush, as in the design of
+   record.  Async mode inside the processor: [clear] is the flush only; it stays a
+   synchronous clear, and the chip reset is the asynchronous reset.  Standalone
+   block (no global net): [clear] is the asynchronous reset. *)
+let fifo_spec ~clock ~clear =
+  if not (async_reset ()) then Reg_spec.create ~clock ~clear ()
+  else match !global_reset with
+    | Some r -> Reg_spec.create ~clock ~reset:r ~clear ()
+    | None -> Reg_spec.create ~clock ~reset:clear ()
+let fifo_regs () = flag "AREA_FIFO_REGS"
+let no_status () = flag "AREA_NO_STATUS"
+let no_mover () = flag "AREA_NO_MOVER"
+let no_shift () = flag "AREA_NO_SHIFT"
+(* AREA_BYTE_SHIFT: SHL/SHR honour only c[4:3] (shift by 0, 8, 16 or 24). *)
+let byte_shift () = flag "AREA_BYTE_SHIFT"
+(* Storage words: never a synchronous clear (like a memory); in async mode they
+   take the chip-wide asynchronous reset (never the flush) so RESET_B needs no tie. *)
+let storage_spec ~clock ~clear =
+  if not (async_reset ()) then Reg_spec.create ~clock ()
+  else match !global_reset with
+    | Some r -> Reg_spec.create ~clock ~reset:r ()
+    | None -> Reg_spec.create ~clock ~reset:clear ()
+let rx_depth default = let d = int "AREA_RX_DEPTH" 0 in if d = 0 then default else d
