+(* Area study: emit standalone Engine / FIFO / Host circuits so each block can be
+   synthesized alone.  Usage: area_blocks <engine|fifo|host> <data_width> <fifo_depth> <out.v> *)
+module Pfifo = Fifo
+open Hardcaml
+open Signal
+let () =
+  let kind = Sys.argv.(1) and width = int_of_string Sys.argv.(2)
+  and depth = int_of_string Sys.argv.(3) and out = Sys.argv.(4) in
+  let config = {Config.default with data_width=width; fifo_words=depth} in
+  let clock = input "clk" 1 and clear = input "clear" 1 in
+  let circuit = match kind with
+    | "engine" ->
+      Area_knobs.prefix := "e0_";
+      let e = Engine.create config
+        {clock; clear; start=input "start" 1; stop=input "stop" 1;
+         clear_fault=input "clear_fault" 1; instruction=input "instruction" 32;
+         image_length=input "image_length" 16; ownership=input "ownership" 8;
+         pins=input "pins" 8; timestamp=input "timestamp" 32;
+         tx_valid=input "tx_valid" 1; tx_data=input "tx_data" width;
+         rx_ready=input "rx_ready" 1; event=input "event_in" 1} in
+      Circuit.create_exn ~name:"engine_block"
+        [output "pc" e.pc; output "running" e.running; output "fault" e.fault;
+         output "stalled" e.stalled; output "tx_pop" e.tx_pop; output "rx_push" e.rx_push;
+         output "rx_data" e.rx_data; output "pin_values" e.pin_values;
+         output "pin_enables" e.pin_enables; output "signal_events" e.signal_events;
+         output "consume_event" e.consume_event; output "completed" e.completed;
+         output "next_pc" (Engine.next_pc e)]
+    | "fifo" ->
+      Area_knobs.prefix := "q0_";
+      let f = Pfifo.create ~clock ~clear ~width ~depth ~push:(input "push" 1)
+          ~pop:(input "pop" 1) ~data:(input "din" width) in
+      Circuit.create_exn ~name:"fifo_block"
+        [output "ready" f.ready; output "valid" f.valid; output "dout" f.data;
+         output "level" f.level]
+    | "host" ->
+      let h = Host.create ~clock ~clear ~ui:(input "ui_in" 8)
+          ~write_ready:(input "write_ready" 1) ~read_valid:(input "read_valid" 1)
+          ~read_data:(input "read_data" 32) ~irq:(input "irq" 1) ~fault:(input "fault" 1) in
