[engines]
smtbmc yices

[script]
read_verilog -DFUNCTIONAL -DSYNTHESIS RM_IHPSG13_1P_core_behavioral.v RM_IHPSG13_1P_64x16_c2.v
~neg: read_verilog processor_fv.v
isa_nop_neg: read_verilog processor_fv_isa_nop_uncounted.v
isa_halt_neg: read_verilog processor_fv_isa_halt_runs.v
isa_set_neg: read_verilog processor_fv_isa_set_unowned.v
isa_dir_neg: read_verilog processor_fv_isa_dir_unowned.v
isa_wait_neg: read_verilog processor_fv_isa_wait_count.v
isa_jmp_neg: read_verilog processor_fv_isa_jmp_target.v
isa_pull_neg: read_verilog processor_fv_isa_pull_empty.v
isa_push_neg: read_verilog processor_fv_isa_push_full.v
isa_out_neg: read_verilog processor_fv_isa_out_value.v
isa_in_neg: read_verilog processor_fv_isa_in_keep.v
isa_count_neg: read_verilog processor_fv_isa_count_value.v
isa_loop_neg: read_verilog processor_fv_isa_loop_keep.v
isa_limit_neg: read_verilog processor_fv_isa_limit_value.v
isa_waitpin_neg: read_verilog processor_fv_isa_waitpin_uncounted.v
isa_signal_neg: read_verilog processor_fv_isa_signal_self.v
isa_waitevent_neg: read_verilog processor_fv_isa_waitevent_empty.v
isa_pins_neg: read_verilog processor_fv_isa_pins_value.v
isa_xfer_neg: read_verilog processor_fv_isa_xfer_issue.v
isa_mov_neg: read_verilog processor_fv_isa_mov_literal.v
isa_load_neg: read_verilog processor_fv_isa_load_value.v
isa_add_neg: read_verilog processor_fv_isa_add_xor.v
isa_xor_neg: read_verilog processor_fv_isa_xor_or.v
isa_and_neg: read_verilog processor_fv_isa_and_or.v
isa_or_neg: read_verilog processor_fv_isa_or_xor.v
isa_shl_neg: read_verilog processor_fv_isa_shl_right.v
isa_shr_neg: read_verilog processor_fv_isa_shr_left.v
isa_jz_neg: read_verilog processor_fv_isa_jz_never.v
isa_not_neg: read_verilog processor_fv_isa_not_copy.v
isa_time_neg: read_verilog processor_fv_isa_time_value.v
isa_fault_neg: read_verilog processor_fv_isa_fault_code.v
isa_invalid_neg: read_verilog processor_fv_isa_invalid_30.v
isa_fetch_neg: read_verilog processor_fv_isa_fetch_bound.v
isa_hold_neg: read_verilog processor_fv_isa_hold_stuck.v
isa_idle_neg: read_verilog processor_fv_isa_idle_x.v
isa_pinmap_neg: read_verilog processor_fv_isa_pinmap_open_drain.v
isa_cmd_select_neg: read_verilog processor_fv_isa_cmd_select.v
isa_cmd_begin_neg: read_verilog processor_fv_isa_cmd_begin.v
isa_cmd_commit_neg: read_verilog processor_fv_isa_cmd_commit.v
isa_cmd_own_neg: read_verilog processor_fv_isa_cmd_own.v
isa_cmd_start_neg: read_verilog processor_fv_isa_cmd_start.v
isa_cmd_stop_neg: read_verilog processor_fv_isa_cmd_stop.v
isa_cmd_route_neg: read_verilog processor_fv_isa_cmd_route.v
isa_cmd_clear_neg: read_verilog processor_fv_isa_cmd_clear.v
isa_cmd_event_neg: read_verilog processor_fv_isa_cmd_event.v
isa_cmd_flush_neg: read_verilog processor_fv_isa_cmd_flush.v
isa_cmd_trigger_neg: read_verilog processor_fv_isa_cmd_trigger.v
isa_queue_tx_neg: read_verilog processor_fv_isa_queue_tx_head.v
isa_queue_rx_neg: read_verilog processor_fv_isa_queue_rx_store.v
isa_xfer_e2e_neg: read_verilog processor_fv_isa_xfer_edges.v
cover: read -formal -DISA_COVER isa_insn.sv isa_cmd.sv isa_spec.sv
neg: read -formal -DISA_NEG isa_insn.sv isa_cmd.sv isa_spec.sv
plain: read -formal isa_insn.sv isa_cmd.sv isa_spec.sv
c_nop: chparam -set CHECK 0 isa_spec
c_halt: chparam -set CHECK 1 isa_spec
c_set: chparam -set CHECK 2 isa_spec
c_dir: chparam -set CHECK 3 isa_spec
c_wait: chparam -set CHECK 4 isa_spec
c_jmp: chparam -set CHECK 5 isa_spec
c_pull: chparam -set CHECK 6 isa_spec
c_push: chparam -set CHECK 7 isa_spec
c_out: chparam -set CHECK 8 isa_spec
c_in: chparam -set CHECK 9 isa_spec
c_count: chparam -set CHECK 10 isa_spec
c_loop: chparam -set CHECK 11 isa_spec
c_limit: chparam -set CHECK 12 isa_spec
c_waitpin: chparam -set CHECK 13 isa_spec
c_signal: chparam -set CHECK 14 isa_spec
c_waitevent: chparam -set CHECK 15 isa_spec
c_pins: chparam -set CHECK 16 isa_spec
c_xfer: chparam -set CHECK 17 isa_spec
c_mov: chparam -set CHECK 18 isa_spec
c_load: chparam -set CHECK 19 isa_spec
c_add: chparam -set CHECK 20 isa_spec
c_xor: chparam -set CHECK 21 isa_spec
c_and: chparam -set CHECK 22 isa_spec
c_or: chparam -set CHECK 23 isa_spec
c_shl: chparam -set CHECK 24 isa_spec
c_shr: chparam -set CHECK 25 isa_spec
c_jz: chparam -set CHECK 26 isa_spec
c_not: chparam -set CHECK 27 isa_spec
c_time: chparam -set CHECK 28 isa_spec
c_fault: chparam -set CHECK 29 isa_spec
c_invalid: chparam -set CHECK 30 isa_spec
c_fetch: chparam -set CHECK 40 isa_spec
c_hold: chparam -set CHECK 41 isa_spec
c_idle: chparam -set CHECK 42 isa_spec
c_pinmap: chparam -set CHECK 43 isa_spec
c_inv: chparam -set CHECK 50 isa_spec
c_reset: chparam -set CHECK 51 isa_spec
c_cmd_select: chparam -set CHECK 60 isa_spec
c_cmd_begin: chparam -set CHECK 61 isa_spec
c_cmd_commit: chparam -set CHECK 62 isa_spec
c_cmd_own: chparam -set CHECK 63 isa_spec
c_cmd_start: chparam -set CHECK 64 isa_spec
c_cmd_stop: chparam -set CHECK 65 isa_spec
c_cmd_route: chparam -set CHECK 66 isa_spec
c_cmd_clear: chparam -set CHECK 67 isa_spec
c_cmd_event: chparam -set CHECK 69 isa_spec
c_cmd_flush: chparam -set CHECK 70 isa_spec
c_cmd_trigger: chparam -set CHECK 71 isa_spec
c_queue_tx: chparam -set CHECK 80 isa_spec
c_queue_rx: chparam -set CHECK 82 isa_spec
c_xfer_e2e: chparam -set CHECK 81 -set XA 2 -set XB 2 isa_spec
c_xfer_e2e_a4: chparam -set CHECK 81 -set XA 4 -set XB 1 isa_spec
c_xfer_e2e_b5: chparam -set CHECK 81 -set XA 1 -set XB 5 isa_spec
