# Line unit (docs/isa.md "Line XFER", "Stuffing"; formal/line_tx.sv): a
# driving line XFER puts the ISA's cells on its pins. Variants with
# options.line_unit only.
#   prove           unbounded (k-induction): any valid LTIM, legal LCFG, N 1..32
#   cover           non-vacuity covers
#   neg_stuff       NEGATIVE CONTROL, must FAIL: stuff_run mutant (stuff bits one bit late)
#   neg_manchester  NEGATIVE CONTROL, must FAIL: manchester_halves mutant
[tasks]
prove
cover
neg_stuff neg
neg_manchester neg

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 40
neg: mode bmc
neg: depth 30
neg: expect fail

[engines]
smtbmc yices

[script]
prove: read_verilog engine_line.v
cover: read_verilog engine_line.v
neg_stuff: read_verilog engine_line_stuff_run.v
neg_manchester: read_verilog engine_line_manchester_halves.v
proc
prove: expose protocol_engine_line/w:transfer_tick protocol_engine_line/w:transfer_period protocol_engine_line/w:tx
~prove: expose protocol_engine_line/w:transfer_tick protocol_engine_line/w:transfer_period
prove: read -formal line_tx.sv
cover: read -formal -DNO_LEMMAS -DTX_COVER line_tx.sv
neg: read -formal -DNO_LEMMAS -DTX_BOUNDED=3 line_tx.sv
prep -top line_tx

[files]
prove: build/rtl/engine_line.v
cover: build/rtl/engine_line.v
neg_stuff: build/rtl/engine_line_stuff_run.v
neg_manchester: build/rtl/engine_line_manchester_halves.v
line_tx.sv
