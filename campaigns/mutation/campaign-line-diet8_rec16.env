# Parameters of the line-unit mutation campaign on variant diet8_rec16 (docs/extension.md
# section 11). Source this file, then run the commands in README.md, section
# "Line unit (diet8_rec16)".
#
# snapshot: git archive of branch eval/diet8-rec16 at this commit; its src/ holds the
# diet8_rec16 core and its test/Makefile defaults to PE_VARIANT=diet8_rec16
SNAPSHOT_COMMIT=f9e0bf9
SNAPSHOT=${PE_WORK:?set PE_WORK to the cluster work directory}/ext-mutation/snap-f9e0bf9
CAMP=${PE_WORK:?set PE_WORK to the cluster work directory}/ext-mutation
PE_VARIANT=diet8_rec16
# src/protocol_emulator_core.v of the snapshot (the published diet8_rec16 core)
CORE_SHA256=d517e277aa2a56f2f4368124581e4ac4d831db209826e377c50127e158566c69
# the same variant without the line unit (scripts/gen_variants.sh diet8), used only for the
# added-or-changed statistic of line_region.py
REFERENCE_SHA256=5fb364f2ad15f55e145b3e059e264c44bf6e4c0fb793e7024c67f458411909e2
# sample: uniform, without replacement, from every mutation of the selection
SEED=20270118
SAMPLE=3000
# stage `ordered`: the variant's 23 default modules (test/Makefile), the three line-unit
# modules first, each passed as COCOTB_TEST_MODULES, stopping at the first failing module
SUITE_MODULES="test_line_unit test_line_random test_line_demos test_smoke test_protocols test_flagship test_legacy test_random test_directed test_mover test_counters test_timewarp test_kill_decode test_kill_blocked test_kill_pc test_kill_mover test_kill_regs test_kill_xfer test_kill_host test_kill_events test_kill_pins test_kill_edges test_kill_fifo"
# the fourteen test_line_spec modules
SPEC_MODULES="test_line_spec_every_engine test_line_spec_crc test_line_spec_lstat test_line_spec_registers test_line_spec_pins test_line_spec_ticker test_line_spec_bounded_wait test_line_spec_state_held test_line_spec_stuffing test_line_spec_xfer_crc_bit test_line_spec_se0_pins test_line_spec_invalid_fields test_line_spec_image_end test_line_spec_limit_bits"
# the first ten, written from the first population's survivors (stage kill-final2 on the first
# sample; appended to SUITE_MODULES in stage ordered of the second and the held-out sample)
SPEC_MODULES_FIRST="test_line_spec_every_engine test_line_spec_crc test_line_spec_lstat test_line_spec_registers test_line_spec_pins test_line_spec_ticker test_line_spec_bounded_wait test_line_spec_state_held test_line_spec_stuffing test_line_spec_xfer_crc_bit"
# written from the second population's survivors: stage kill3 (the three, as first written) and
# kill-final2; stage kill4 runs these four as now written (image_end with five more cases,
# limit_bits new) on every sample
SPEC_MODULES_SECOND="test_line_spec_se0_pins test_line_spec_invalid_fields test_line_spec_image_end"
SPEC_MODULES_KILL4="test_line_spec_se0_pins test_line_spec_invalid_fields test_line_spec_image_end test_line_spec_limit_bits"
# stage kill5: the two modules that are new or have new cases, on every first-sample survivor of the
# committed suite, for the per-module kill counts (docs/extension.md section 11.3)
SPEC_MODULES_KILL5="test_line_spec_image_end test_line_spec_limit_bits"
# second population (line_region.py sel/ext.txt): sample at the first population's sampling
# fraction, round(63773 * 3000 / 90372) = 2117, same seeds
EXT_SAMPLE=2117
# held-out sample of the first population: 1000 of the mutations the first sample did not draw
# (gen_line_mutants.sh EXCLUDE=design/sample_index.tsv), mutate seed SEED, draw seed HELD_SEED
HELD_SAMPLE=1000
HELD_SEED=20270119
# formal classification: the options of docs/mutation-push.md section 4.5 (longer cap)
FORMAL_ARGS="--props strict --pdr-seconds 600 --abc-timeout 900"
# queue depth of diet8 (invariant library of equiv_inv.py, einv_specs.py --fifo-depth)
FIFO_DEPTH=8
# control samples are drawn with random.seed(20270118)
SAMPLE_SEED=20270118
