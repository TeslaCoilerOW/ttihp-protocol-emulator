# Parameters of the diet4 (6x4 candidate) mutation campaign, docs/verification-campaign.md
# section "Variant diet4 (6x4) campaigns". Source this file, then run the commands in
# README.md, section "Design variants".
SNAPSHOT_COMMIT=c118027
SNAPSHOT=${PE_WORK:?set PE_WORK to the cluster work directory}/sixby4-verify/snapshot-c118027
CAMP=${PE_WORK:?set PE_WORK to the cluster work directory}/sixby4-verify/mutation
PE_VARIANT=diet4
# diet4 core generated in the snapshot by scripts/gen_variants.sh diet4
CORE_SHA256=cc27c465c877f0ab3b9491de1ae0fb2bf084e97e001a83e768fb676ac8b6ebba
# same seed and region quotas as the 73536f0 campaign (campaign.env)
SEED=20270118
QUOTAS=engine_ctrl=550,host=400,mover=250,events=300,pins=250,engine_xfer=200,imem=60,shared=90,fifo=130,engine_data=180,timestamp=10
# stages: fast (first), then suite (the snapshot's whole suite, 66 tests) on the fast-set survivors
SECOND_STAGE=suite
