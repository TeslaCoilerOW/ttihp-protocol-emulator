# Parameters of the diet4 re-run under the 102-test suite (docs/mutation-push.md, section
# 7). The mutants are those of campaign-diet4.env (same design directory,
# same base.il and mutations.tsv); only the test tree changes. Source campaign-diet4.env
# first (CAMP there = the earlier campaign), then this file, then run the commands in
# README.md, section "Variant diet4 under the 102-test suite".
OLD_CAMP=$CAMP        # the earlier campaign: design/ (mutants) and results/equiv/ (equiv_mutant.py) are reused
SRC_DESIGN=$OLD_CAMP/design
SNAPSHOT_COMMIT=4bd30c8
SNAPSHOT=${PE_WORK:?set PE_WORK to the cluster work directory}/mutation-cleanup/snapshot-4bd30c8
CAMP=${PE_WORK:?set PE_WORK to the cluster work directory}/mutation-cleanup/diet4
PE_VARIANT=diet4
# the regenerated core in the snapshot must equal the mutated core (and variants6x4/)
CORE_SHA256=cc27c465c877f0ab3b9491de1ae0fb2bf084e97e001a83e768fb676ac8b6ebba
# one stage: the snapshot's whole suite (test/Makefile default, 102 tests in 20 modules)
FIRST_STAGE=suite
FORMAL_ARGS="--props strict --pdr-seconds 60 --abc-timeout 150"
# queue depth of diet4 (invariant library of equiv_inv.py, einv_specs.py --fifo-depth)
FIFO_DEPTH=4
# control samples are drawn with random.seed(20270118)
SAMPLE_SEED=20270118
